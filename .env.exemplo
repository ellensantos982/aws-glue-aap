# Copiado para .env pelo "bash poc.sh preparar". O .env não vai para o Git.

# ServiceNow (instância de desenvolvimento gratuita)
SN_HOST=https://devXXXXXX.service-now.com
# Senha do usuário de integração poc.integracao.aws (a mesma definida na ServiceNow)
SN_INTEGRACAO_SENHA=
# Só para "bash poc.sh servicenow" (configuração completa por API). Deixe a senha vazia:
# o comando pede na hora e ela não fica gravada em disco
SN_ADMIN_USER=admin
SN_ADMIN_SENHA=

# Token que a ServiceNow manda para o EDA (gerado automaticamente)
EDA_TOKEN=

# AWS: use um perfil do ~/.aws/credentials (ou AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
AWS_PROFILE=poc
AWS_REGION=us-east-1
# E-mail que recebe o alarme de eventos não entregues à ServiceNow (opcional)
ALERTAS_EMAIL=
